{
  "manifest_version": 3,
  "name": "Pongy — Wake Focus",
  "version": "0.26.1",
  "description": "Activates the existing Pongy AI tab after its voice wake request. No microphone access.",
  "key": "",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://pongy-ai.devs.surf/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://pongy-ai.devs.surf/*"
    ]
  },
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pongy — Wake Focus"
  }
}
