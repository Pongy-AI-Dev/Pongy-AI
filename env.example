# Never commit real secrets. End users do not enter an AI key.
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000
DATA_DIR=./data
# Configure once in deployment environment, not in frontend code.
OPENROUTER_API_KEY=
# Backward-compatible OPENROUTER_KEY is also accepted.
RESEND_API_KEY=
MAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# JWT_SECRET and SESSION_SECRET are securely generated in data/secrets.json
# when omitted. For multi-instance deployment, supply shared 32+ character secrets.
JWT_SECRET=
SESSION_SECRET=
MAX_OUTPUT_TOKENS=2048
MAX_AI_ATTEMPTS=6
FREE_MODEL_PREFERENCES=
# Same-origin hosting is recommended. Split hosting needs HTTPS, a configured
# public API origin, explicit frontend CORS origin, and cross-site cookie policy.
PUBLIC_API_ORIGIN=
CORS_ORIGINS=
COOKIE_SAMESITE=lax
# Set only when the deployment platform requires a known trusted proxy hop count.
TRUST_PROXY=
# Firebase public Web API key (not a service-account private key).
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
# Optional durable storage. Create (default) Firestore and publish firestore.rules first.
FIREBASE_FIRESTORE_ENABLED=false
# On ephemeral hosting, ALWAYS set fixed JWT_SECRET and SESSION_SECRET above.

# Optional image generation uses the existing server OpenRouter key. May incur charges.
IMAGE_GENERATION_ENABLED=false
IMAGE_MODEL=
