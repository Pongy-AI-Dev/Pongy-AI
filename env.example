# Template only. Store real values in Render Environment or an untracked .env.
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000
DATA_DIR=data
# Optional: DATABASE_PATH=data/pongy.db

# Optional independent free fallback. Visitors never enter provider keys.
OPENROUTER_API_KEY=
MAX_OUTPUT_TOKENS=8192
MAX_CODING_OUTPUT_TOKENS=32768
MAX_OUTPUT_TOKENS=16384
# Long answers continue automatically (up to 24 rounds). Raise the total deadline for very long code/document answers.
# AI_TOTAL_MS=180000
# AI_PROJECT_TOTAL_MS=300000
MAX_AI_ATTEMPTS=10
# Optional override: only live zero-priced :free entries are eligible.
# Leave empty for built-in task-specific defaults and the free router fallback.
FREE_MODEL_PREFERENCES=

# Firebase email/password authentication. Set both, or leave both empty.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
# Optional cloud history; local browser history does not require Firestore.
FIREBASE_FIRESTORE_ENABLED=false

# Optional Google OAuth. Callback must match the Google Cloud client exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
# Optional GitHub OAuth App. Register the API origin's /auth/github/callback URL.
# When Firebase auth is enabled, enable GitHub in Firebase Authentication with the same client.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# Alternative legacy mail delivery; not required in Firebase auth mode.
RESEND_API_KEY=
MAIL_FROM=
# SMTP delivery for in-app reviews and reminder email notifications.
# Reviews go to pongy.support@gmail.com; reminders go to the verified account address.
# These seven keys may also be placed in data/secrets.json (smtpHost, smtpPort, smtpSecure,
# smtpUser, smtpPass, mailFrom, mailProvider or resendKey) when environment variables
# are inconvenient - env values always win.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Optional search providers. Tavily is preferred when configured.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Google AI Studio. Keep the Google project on the free tier; these flags do not override Google billing.
GEMINI_ENABLED=true
GEMINI_ALLOW_PAID=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite

# Restricted Workers AI token only. Never use a Global API Key.
IMAGE_GENERATION_ENABLED=true
IMAGE_PROVIDER=cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGE_STEPS=4
# Account-wide request cap in this application, NOT a Neuron balance guarantee.
CLOUDFLARE_IMAGE_DAILY_LIMIT=60
# Ignored for Cloudflare; its model is fixed to FLUX.1 schnell.
IMAGE_MODEL=

# Set stable random values of at least 32 characters on Render.
# Never replace existing secrets during an ordinary update.
JWT_SECRET=
SESSION_SECRET=

# Same-origin hosting is recommended. Keep existing deployment values.
PUBLIC_API_ORIGIN=
CORS_ORIGINS=
COOKIE_SAMESITE=lax
# Set only if required by a known reverse-proxy configuration.
TRUST_PROXY=

# Optional scarce APILayer product lookups. Disabled by default. Never put real keys in this file.
APILAYER_ENABLED=false
APILAYER_API_KEY=
# Server cap per product: <=100 calls in any 31 days (all users combined). Failed calls count.
APILAYER_MONTHLY_LIMIT=100
# Optional product-specific keys override the shared key. Direct product API keys may differ.
APILAYER_MEDIASTACK_KEY=
APILAYER_NUMVERIFY_KEY=
APILAYER_IPSTACK_KEY=
APILAYER_AVIATIONSTACK_KEY=
APILAYER_POSITIONSTACK_KEY=
APILAYER_COUNTRYLAYER_KEY=
APILAYER_MARKETSTACK_KEY=
APILAYER_MAILBOXLAYER_KEY=

# Optional response timing in milliseconds; defaults already apply without these variables.
AI_FIRST_TOKEN_MS=15000
AI_COMPLEX_FIRST_TOKEN_MS=22000
AI_ATTEMPT_MS=45000
AI_TOTAL_MS=90000
# Larger coding projects only; ordinary chat keeps AI_TOTAL_MS.
AI_PROJECT_TOTAL_MS=180000

# Explicit operator-controlled maintenance notice
MAINTENANCE_MODE=false

# Optional direct official DeepSeek API. It is billed to the SERVER OWNER, not free.
# All three settings are required to activate; a key alone never enables billing.
DEEPSEEK_ENABLED=false
DEEPSEEK_ALLOW_PAID=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Optional private read-only AI connections (separate from sign-in).
# Google falls back to GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET when these are empty.
# Register each enabled callback: PUBLIC_API_ORIGIN/api/connections/{service}/callback
# service: google-drive, gmail, google-calendar, github, slack
CONNECTION_GOOGLE_CLIENT_ID=
CONNECTION_GOOGLE_CLIENT_SECRET=
CONNECTION_GITHUB_CLIENT_ID=
CONNECTION_GITHUB_CLIENT_SECRET=
CONNECTION_SLACK_CLIENT_ID=
CONNECTION_SLACK_CLIENT_SECRET=
# GitHub fine-grained token connection works without an OAuth app.
# Do not put user access tokens into .env; users enter them in Add Connections.
